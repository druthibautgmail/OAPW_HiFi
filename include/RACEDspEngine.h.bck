#ifndef RACE_DSP_ENGINE_H
#define RACE_DSP_ENGINE_H

#include <vector>
#include <mutex>
#include <array>
#include <complex>
#include <cstdint> // NEU: Für int32_t (ALSA 32-Bit Output)

// ---------------------------------------------------------
// BiquadFilter: Komplett auf 64-Bit (double) umgestellt
// Standard-Samplerate auf 192000 Hz angehoben
// ---------------------------------------------------------
class BiquadFilter {
private:
    double b0, b1, b2, a1, a2;
    double z1, z2; 
    double freq, q, gainDb;
    int sampleRate;

public:
    BiquadFilter();
    void setParameters(double frequency, double qFactor, double gainDb, int sampleRate = 192000);
    double process(double in);
    
    double getFreq() const { return freq; }
    double getQ() const { return q; }
    double getGain() const { return gainDb; }
};

// ---------------------------------------------------------
// IIRFilter: Lief bereits auf double (gut!)
// ---------------------------------------------------------
class IIRFilter {
private:
    std::vector<double> ac;
    std::vector<double> bc;
    std::vector<double> x;
    std::vector<double> y;
    int order;

public:
    IIRFilter(const std::vector<double>& a, const std::vector<double>& b);
    double process(double input);
};

// ---------------------------------------------------------
// RACEDspEngine: 64-Bit DSP Engine mit ALSA 32-Bit Output
// ---------------------------------------------------------
class RACEDspEngine {
private:
    int sampleRate;          // NEU: Samplerate für Delay/EQ Berechnung (192000)

    double delayUs;            
    double attenuationDb;      
    double attenuationLinear; 
    int dn;                  // Delay in Samples (muss bei 192kHz neu berechnet werden!)
    
    double centerP;
    bool freqLimitRACE;
    double volume; 
    bool raceEnabled;
    bool filtersEnabled;
    bool eqEnabled; 

    // Real-Time Analyzer (kann in double bleiben, oder für GUI nach float gewandelt werden)
    std::vector<double> spectrumBuffer;
    int spectrumIndex;

    // Buffer auf 64-Bit Precision umgestellt
    std::vector<double> delayBufferL;
    std::vector<double> delayBufferR;
    int writeIndex;

    IIRFilter lpfL;
    IIRFilter lpfR;
    IIRFilter hpfL;
    IIRFilter hpfR;

    std::array<BiquadFilter, 3> eqL;
    std::array<BiquadFilter, 3> eqR;

    std::mutex dspMutex;

public:
    // Konstruktor erweitert um sampleRate (Standard 192kHz)
    RACEDspEngine(double initialDelayUs, double initialAttenuationDb, double initialCenterP, bool initialFreqLimit, int sampleRate = 192000);
    ~RACEDspEngine();

    // Alle Audio-Parameter auf 64-Bit (double) gehoben
    void setParameters(double newDelayUs, double newAttenuationDb, double newCenterP, bool newFreqLimit);
    void setVolume(double newVolume); 
    void setRaceEnabled(bool enabled);
    void setFiltersEnabled(bool enabled);
    
    void setEqEnabled(bool enabled);
    void setEqBand(int bandIndex, double freq, double q, double gainDb);

    double getDelayUs();
    double getAttenuationDb();
    double getCenterP();
    bool getFreqLimit();
    double getVolume();
    bool getRaceEnabled();
    bool getFiltersEnabled();
    
    bool getEqEnabled();
    double getEqFreq(int bandIndex);
    double getEqQ(int bandIndex);
    double getEqGain(int bandIndex);

    std::vector<double> getSpectrumBands();

    // ------------------------------------------------------------------------
    // AUDIO PROCESSING FUNKTIONEN
    // ------------------------------------------------------------------------

    // Klassische Funktion (nur für 64-Bit Float Interleaved Processing)
    // Achtung bei 192kHz: Vermeide Re-Allokationen des std::vector zur Laufzeit!
    void processSamples(std::vector<double>& interleavedSamples);

    // NEU: Hochoptimierte Funktion für direkte ALSA-Ausgabe.
    // Liest 64-Bit Float (DSP Input), verarbeitet in 64-Bit, und konvertiert direkt 
    // in 32-Bit Integer Interleaved für den Hardware DAC (S32_LE).
    // Nutzt C-Arrays (Pointer) für maximale Performance im Audio-Thread.
    // 
    // @param inBuffer64      Input-Samples als 64-Bit double (Interleaved L/R)
    // @param outAlsaBuffer32 Output-Samples als 32-Bit int (Interleaved L/R)
    // @param frames          Anzahl der Frames (1 Frame = 1 Sample Links + 1 Sample Rechts)
    void processFramesForAlsa(const double* inBuffer64, int32_t* outAlsaBuffer32, int frames);
};

#endif // RACE_DSP_ENGINE_H
